    },
    {
      "id": "ARM946ES-ARM-QADD-FLAGS-001",
      "profiles": ["ARM9_PROFILE_ARM946ES"],
      "category": "status_and_modes",
      "statement": "A saturating arithmetic operation requests Q when either specified saturation occurs, Q is sticky when applied, and the operation does not change N, Z, C, or V.",
      "source_refs": [{"source": "DDI0100I", "locator": "§A4.1.46, §A4.1.50-§A4.1.52 Operation and Condition flags"}],
