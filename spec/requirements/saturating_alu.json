      "id": "ARM946ES-ARM-QADD-ARITHMETIC-001",
      "profiles": ["ARM9_PROFILE_ARM946ES"],
      "category": "arm_instruction_semantics",
      "statement": "QADD and QSUB saturate signed addition or subtraction to the 32-bit signed range; QDADD and QDSUB first saturate Rn multiplied by two and then independently saturate addition or subtraction from Rm.",
      "source_refs": [{"source": "DDI0100I", "locator": "§A4.1.46 QADD; §A4.1.50 QDADD; §A4.1.51 QDSUB; §A4.1.52 QSUB"}],
