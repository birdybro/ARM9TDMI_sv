    },
    {
      "id": "ARM946ES-AHB-001",
      "profiles": ["ARM9_PROFILE_ARM946ES"],
      "category": "arm946_ahb",
      "statement": "The BIU is an AMBA Rev 2.0 AHB master using pipelined address/control and data phases; HREADY low extends the current data phase and the next address/control phase.",
      "source_refs": [
        {"source": "DDI0201D", "locator": "§6.1; §6.2; §6.2.1"},
