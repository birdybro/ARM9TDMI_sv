    {
      "id": "ARM946ES-AHB-002",
      "profiles": ["ARM9_PROFILE_ARM946ES"],
      "category": "arm946_ahb",
      "statement": "Linefills are aligned fixed INCR8 bursts of eight words; dirty half-lines use INCR4 and dirty full lines use INCR8 write-back bursts.",
