{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/birdybro/ARM9TDMI_sv/spec/schema.json",
  "title": "ARM9TDMI_sv engineering requirement file",
  "type": "object",
  "required": ["schema_version", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "profiles", "category", "statement", "source_refs",
          "implementation", "verification"
        ],
        "properties": {
          "id": {"pattern": "^(COMMON|ARM9TDMI|ARM946ES)-[A-Z0-9-]+-[0-9]{3}$"},
          "profiles": {
            "type": "array",
            "items": {
              "enum": ["ARM9_PROFILE_ARM9TDMI", "ARM9_PROFILE_ARM946ES"]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "category": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "locator"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "minLength": 1}
              }
            }
          },
          "implementation": {
            "type": "object",
            "required": ["status", "rtl"],
            "properties": {
              "status": {"type": "string"},
              "rtl": {"type": "array", "items": {"type": "string"}}
            }
          },
          "verification": {
            "type": "object",
            "required": ["status", "tests"],
            "properties": {
              "status": {"type": "string"},
              "tests": {"type": "array", "items": {"type": "string"}}
            }
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
